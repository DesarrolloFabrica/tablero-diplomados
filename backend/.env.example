# Copiar a backend/.env para desarrollo local (nunca se sube a git).
# También se lee el .env de la raíz del repo si existe.

DB_HOST=136.113.128.135          # IP pública de core-database (tu IP debe estar autorizada)
DB_PORT=5432
DB_NAME=core
DB_USER=user-core                # también se acepta DB_USERNAME
DB_PASSWORD=
DB_SCHEMA=ventas_ec
DB_SSLMODE=require

# Solo en Cloud Run: conexión por socket del conector de Cloud SQL (ignora DB_HOST).
# INSTANCE_CONNECTION_NAME=it-fab-contenido-edu-6:us-central1:core-database

# Opcionales
# CACHE_TTL_SECONDS=300
# CORS_ORIGINS=http://localhost:5173
